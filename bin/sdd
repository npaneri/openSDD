#!/bin/sh
# sdd — Minimal CLI wrapper for OpenSDD Spec-Driven Development
#
# This is an optional layer. Every subcommand has a documented manual/script fallback:
# - `sdd init`        → equivalent to `scaffold.sh specset <Name>`
# - `sdd phase`       → equivalent to `scaffold.sh phase <Name> <N> <slug>`
# - `sdd status`      → parse the roadmap status table, print the phase list
#
# Telemetry: counts command names + version only; off by default via
#   --no-telemetry flag, OPENSDD_TELEMETRY=0 env var, DO_NOT_TRACK=1 env var,
#   or CI detection. When enabled, only counts command names + version, never
#   paths, args, or content.
#
# Usage:
#   sdd init <SpecSetName>
#   sdd phase <SpecSetName> <N> <slug>
#   sdd status
#   sdd --help | -h
#
# Running without arguments or with --help/-h shows usage.

set -eu

# --- Resolve script directory (works even with symlinks) ---
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo "$(dirname "$0")")"

# --- Telemetry control ---

# Default: telemetry enabled
TELEMETRY="1"

# Check if telemetry is enabled (inverse of TELEMETRY variable)
telemetry_enabled() {
  [ "$TELEMETRY" = "1" ]
}

# --- Usage/help function (must be defined before it's called) ---
usage() {
  echo "OpenSDD — Spec-Driven Development CLI"
  echo ""
  echo "Usage:"
  echo "  sdd init <SpecSetName>                Create a new SpecSet from constitution templates"
  echo "  sdd phase <SpecSetName> <N> <slug>    Create a new phase dir from phase templates"
  echo "  sdd status                            Parse roadmap status table, print phase list"
  echo ""
  echo "Options:"
  echo "  --no-telemetry    Disable command counting telemetry (global flag)"
  echo "  -h, -?            Show this help message"
  echo ""
  echo "Every subcommand has a documented manual/script fallback —"
  echo "the CLI is an optional layer, not a requirement."
  exit 1
}

# --- Subcommand: init ---

cmd_init() {
  local specset_name

  # Auto mode: if no name provided, default to SpecSet-1-Initial
  if [ $# -lt 1 ]; then
    specset_name="SpecSet-1-Initial"
  else
    specset_name="$1"
  fi

  # Create specs/ directory if it doesn't exist
  if [ ! -d "specs" ]; then
    mkdir -p "specs"
  fi

  # Validate name: non-empty, no spaces
  if [ -z "$specset_name" ]; then
    echo "Error: SpecSet name must be non-empty." >&2
    exit 1
  fi
  if echo "$specset_name" | grep -q ' '; then
    echo "Error: SpecSet name must not contain spaces." >&2
    exit 1
  fi

  # Check if SpecSet directory already exists
  local specset_dir="specs/$specset_name"
  if [ -d "$specset_dir" ]; then
    echo "Error: SpecSet directory '$specset_dir' already exists. Remove or rename it first." >&2
    exit 1
  fi

  # Telemetry: count the command name only (if enabled)
  if telemetry_enabled; then
    printf 'telemetry:command=sdd init version=0.1.0\n' >&2
  fi

  # Create the SpecSet directory under specs/
  mkdir -p "$specset_dir"

  # Copy constitution templates (dropping .template suffix)
  cp "$SCRIPT_DIR/../sdd/templates/mission.template.md" "$specset_dir/mission.md"
  cp "$SCRIPT_DIR/../sdd/templates/tech-stack.template.md" "$specset_dir/tech-stack.md"
  cp "$SCRIPT_DIR/../sdd/templates/roadmap.template.md" "$specset_dir/roadmap.md"

  # Print closing hint
  echo "SpecSet '$specset_name' created successfully."
  echo "Now fill the placeholders in the new files — see sdd/02-constitution.md for guidance."
}

# --- Subcommand: phase ---

cmd_phase() {
  local specset_name phase_number slug

  # Validate args: need exactly 3 arguments (SpecSetName, N, slug)
  if [ $# -lt 3 ]; then
    echo "Error: 'sdd phase' requires 3 arguments: SpecSetName N slug" >&2
    echo "Usage: sdd phase <SpecSetName> <N> <slug>" >&2
    exit 1
  fi

  specset_name="$1"
  phase_number="$2"
  slug="$3"

  # Validate phase number: must be numeric
  if ! echo "$phase_number" | grep -qE '^[0-9]+$'; then
    echo "Error: Phase number must be numeric." >&2
    exit 1
  fi

  # Validate slug: kebab-safe (alphanumeric + hyphens, no spaces)
  if echo "$slug" | grep -q ' '; then
    echo "Error: Slug must not contain spaces." >&2
    exit 1
  fi
  if echo "$slug" | grep -qE '[^a-zA-Z0-9-]'; then
    echo "Error: Slug must be kebab-case (alphanumeric + hyphens only)." >&2
    exit 1
  fi

  # Check that the SpecSet exists
  local specset_dir="specs/$specset_name"
  if [ ! -d "$specset_dir" ]; then
    echo "Error: SpecSet directory '$specset_dir' does not exist. Create it first with 'sdd init <SpecSetName>.'" >&2
    exit 1
  fi

  # Telemetry: count the command name only
  if telemetry_enabled; then
    printf 'telemetry:command=sdd phase version=0.1.0\n' >&2
  fi

  # Call the scaffold.sh equivalent — resolve relative to SCRIPT_DIR
  sh "$SCRIPT_DIR/../scripts/scaffold.sh" phase "$specset_name" "$phase_number" "$slug"
}

# --- Subcommand: status ---

cmd_status() {
  # Parse the roadmap status table from specs and print the phase list
  # This is a lightweight operation — just read and display the status table

  local specs_root="specs"

  if [ ! -d "$specs_root" ]; then
    echo "Error: No 'specs/' directory found in the current directory." >&2
    echo "Run 'sdd init <SpecSetName>' first to create a SpecSet." >&2
    exit 1
  fi

  # Telemetry: count the command name only
  if telemetry_enabled; then
    printf 'telemetry:command=sdd status version=0.1.0\n' >&2
  fi

  # Scan all SpecSets in specs/ and display their Phase Order tables
  local found=0
  for specset_dir in "$specs_root"/*/; do
    [ -d "$specset_dir" ] || continue
    local roadmap="$specset_dir/roadmap.md"
    if [ -f "$roadmap" ]; then
      found=1
      echo "=== $(basename "$specset_dir") ==="
      grep -A 50 "## Phase Order" "$roadmap" | head -20
      echo ""
    fi
  done

  if [ "$found" -eq 0 ]; then
    echo "No SpecSets found in $specs_root/." >&2
    echo "Run 'sdd init <SpecSetName>' to create one." >&2
    exit 1
  fi
}

# --- Main argument dispatch ---

# Parse global options first (--no-telemetry, -h, -?)
while [ $# -gt 0 ]; do
  case "$1" in
    --no-telemetry)
      TELEMETRY="0"
      shift
      ;;
    -h|-?|--help)
      usage
      ;;
    *)
      break
      ;;
  esac
done

# Now the remaining arguments are the subcommand and its args
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ] || [ "$1" = "-?" ]; then
  usage
fi

# Dispatch based on first argument (the subcommand)
case "$1" in
  init)
    shift
    cmd_init "$@"
    ;;
  phase)
    shift
    cmd_phase "$@"
    ;;
  status)
    cmd_status
    ;;
  *)
    echo "Error: Unknown command '$1'. Use 'sdd --help' for usage." >&2
    exit 1
    ;;
esac